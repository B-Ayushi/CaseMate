# Copy this file to server/.env and fill in real values. Never commit server/.env.

# HTTP port for the API server
PORT=4000

# MySQL connection strings (the test database must be a separate database).
# URL-encode special characters in the password, e.g. @ becomes %40.
DATABASE_URL=mysql://root:your-password@localhost:3306/casemate
DATABASE_URL_TEST=mysql://root:your-password@localhost:3306/casemate_test

# Secret used to sign login tokens: a long random string
JWT_SECRET=replace-with-a-long-random-string

# Origin of the web client, used for CORS and links in emails
CLIENT_URL=http://localhost:5173

# All dates are shown and interpreted in this time zone
APP_TIMEZONE=Asia/Kolkata

# Email (SMTP via Nodemailer). If left empty the server still starts, but every email
# (password resets, reminders, invoices) fails with "Email is not configured".
# Port 587 uses STARTTLS, port 465 uses TLS. For Gmail use smtp.gmail.com, port 587,
# your Gmail address as SMTP_USER and a Google "App password" (not your normal
# password) as SMTP_PASS. EMAIL_FROM should use the same address as SMTP_USER.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="CaseMate <no-reply@example.com>"

# SMS (Twilio). If left empty, SMS reminders fail with "SMS is not configured" and are
# marked FAILED after their retries. TWILIO_FROM_NUMBER is your Twilio number in +E.164
# form, e.g. +14155550123. Messages go to the lawyer's mobile number in +91 form. On a
# Twilio trial account the lawyer's number must first be added as a Verified Caller ID.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Set to true to run the reminder scheduler (every 5 minutes) inside the API server.
# Several servers may have it on: claiming in the database keeps any reminder from being
# sent twice. `npm run reminders:tick` runs a single pass whatever this is set to.
ENABLE_SCHEDULER=false
